# TeamFollowUP - environment configuration (backend/app/config.py)
# Copy to .env and override ALL secrets for non-dev. Values below are DEV DEFAULTS.

# --- Core (MUST override in production) ---
SECRET_KEY=change-me-in-prod-please-32chars-min-secret   # session cookie signing - set a strong random value
SESSION_COOKIE=trt_session
SESSION_MAX_AGE_SECONDS=43200                            # 12h
COOKIE_SECURE=false                                      # set true behind TLS (production)
COOKIE_SAMESITE=lax                                      # lax | strict | none

# --- Hardening ---
LOGIN_MAX_ATTEMPTS=10                                    # failed logins per IP per window (0 = disabled)
LOGIN_WINDOW_SECONDS=300
AUDIT_RETENTION_DAYS=0                                   # 0 = keep forever

# --- Backups (docker compose --profile backup up -d) ---
BACKUP_KEEP=14
BACKUP_INTERVAL_SECONDS=86400

# --- Database ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=tribe
POSTGRES_USER=tribe
POSTGRES_PASSWORD=tribe                                  # MUST override in production

# --- App behaviour ---
APP_NAME=TeamFollowUP
STALENESS_THRESHOLD_DAYS=7
SEED_DEMO=true                                           # set false in production

# --- Break-glass admin (recovery) ---
BREAKGLASS_EMAIL=admin@local
BREAKGLASS_PASSWORD=                                     # empty -> random generated & logged once at first boot

# --- Public URL (the one value to set when deploying) ---
# The address users type in their browser, scheme + host (+ port if non-standard),
# no trailing slash. NOT the port the container listens on: behind a Gateway/ALB
# the pod speaks HTTP on :8000 while the public URL is HTTPS on :443.
# Empty -> derived from each incoming request (X-Forwarded-Proto / -Host are
# honoured), which is correct for local dev and any single-hostname deployment.
# Also editable at runtime in Admin > Authentication.
PUBLIC_BASE_URL=                                         # e.g. https://teamfollowup.example.com

# Every IdP-facing URL is derived from PUBLIC_BASE_URL, so there is nothing to
# keep in sync by hand:
#   OIDC redirect  <PUBLIC_BASE_URL>/api/auth/oidc/callback
#   SAML entity ID <PUBLIC_BASE_URL>/api/auth/saml/metadata
#   SAML ACS       <PUBLIC_BASE_URL>/api/auth/saml/acs
# The three variables below only exist to PIN a different value when an IdP
# registration mandates one. Leave them empty otherwise.

# --- OIDC (optional SSO) ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_REDIRECT_URI=                                       # empty -> derived from PUBLIC_BASE_URL

# --- SAML (optional SSO) ---
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_IDP_METADATA_PATH=
SAML_SP_ENTITY_ID=                                       # empty -> derived from PUBLIC_BASE_URL
SAML_ACS_URL=                                            # empty -> derived from PUBLIC_BASE_URL
SAML_SP_CERT=
SAML_SP_KEY=

# --- Deployment / serving ---
# TLS_ENABLED=false (recommended, the compose + GKE default): the app serves plain
# HTTP on HTTP_PORT and the infrastructure terminates TLS.
# TLS_ENABLED=true: the app terminates TLS itself on HTTPS_PORT (8443), with a
# self-signed certificate generated at first boot (replaceable in Admin > HTTPS).
# HTTP -> HTTPS redirection is never the app's job.
# NOTE: APP_HTTP_PORT / APP_HTTPS_PORT are read by the ROOT docker-compose.yml
# (host-side mapping), not by backend/app/config.py, which reads HTTP_PORT / HTTPS_PORT.
TLS_ENABLED=false
HTTP_PORT=8000
APP_HTTP_PORT=8000                                       # host port -> container :8000 (HTTP)

# --- Logging ---
# LOG_FORMAT=json emits one JSON object per line, the shape GCP Cloud Logging (and
# most log collectors) parses natively; anything else keeps human-readable lines.
# LOG_LEVEL is the boot level; it can be changed live, and persisted, in Admin > Ops.
LOG_FORMAT=text
LOG_LEVEL=INFO

# SMTP, modules, personas, report schedule, branding are configured at RUNTIME
# in the Admin UI (stored in the app_settings table), not via environment variables.
