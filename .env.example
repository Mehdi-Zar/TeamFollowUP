# ============================================================================
# TeamFollowUP - configuration. Copiez ce fichier en `.env`.
#   cp .env.example .env  &&  docker compose up -d --build
# Toutes les valeurs ci-dessous ont des défauts fonctionnels : l'app démarre
# telle quelle, sans modification, sur http://localhost:8000.
# ============================================================================

# --- Exposition de l'application (UI + API) ---
# L'app sert l'UI et l'API en HTTP simple sur un PORT UNIQUE, et laisse le TLS
# à l'infrastructure en amont (Gateway API sur GKE, ALB, reverse proxy...).
# C'est le modèle recommandé et le défaut. En local :  http://localhost:8000
APP_HTTP_PORT=8000
TLS_ENABLED=false
# TLS_ENABLED=true fait terminer le TLS par l'app elle-même sur le port 8443
# (certificat auto-signé au 1er démarrage, remplaçable dans Administration >
# HTTPS / Certificats). Dans ce cas, exposez APP_HTTPS_PORT=8443 à la place
# de APP_HTTP_PORT et adaptez PUBLIC_BASE_URL ci-dessous.

# --- URL publique (indispensable dès que l'app est déployée) ---
# L'adresse que vos utilisateurs saisissent dans leur navigateur, sans slash
# final. C'est la SEULE valeur qui décrit l'app vue de l'extérieur : toutes les
# URL de rappel OIDC / SAML en découlent automatiquement.
# Ce n'est PAS le port d'écoute du conteneur : derrière une Gateway, le pod
# écoute en HTTP sur 8000 alors que l'URL publique est en HTTPS sur 443.
#   local        : http://localhost:8000  (ou laissez vide, voir ci-dessous)
#   déployé      : https://teamfollowup.exemple.com
# Laissé VIDE, l'app déduit l'URL de chaque requête reçue (en tenant compte de
# X-Forwarded-Proto / X-Forwarded-Host) : suffisant tant que l'application est
# jointe par une seule adresse. Renseignez-la dès que ce n'est plus le cas.
# Modifiable aussi à chaud dans Administration > Authentification.
PUBLIC_BASE_URL=

# --- Cookies de session ---
# En HTTP simple les cookies ne peuvent pas être "Secure" (le navigateur ne les
# renverrait pas). Passez COOKIE_SECURE=true dès que l'app est publiée en HTTPS,
# y compris quand c'est la Gateway qui termine le TLS.
COOKIE_SECURE=false

# --- Base de données PostgreSQL (interne au compose) ---
POSTGRES_DB=tribe
POSTGRES_USER=tribe
POSTGRES_PASSWORD=tribe

# --- Sécurité ---
# Clé de signature des sessions (JWT + cookies). À CHANGER en production.
SECRET_KEY=change-me-in-prod-please-32chars-min-secret

# --- Règles métier ---
# Seuil (en jours) au-delà duquel la donnée d'une équipe est marquée "périmée".
# Modifiable aussi à chaud dans l'écran Administration.
STALENESS_THRESHOLD_DAYS=7

# --- Journaux ---
# LOG_FORMAT=json : une ligne = un objet JSON, le format que GCP Cloud Logging
# (et la plupart des collecteurs) analyse nativement. Toute autre valeur garde
# des lignes lisibles à l'oeil. LOG_LEVEL est le niveau au démarrage ; il se
# change à chaud, et se persiste, dans Administration > Ops.
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Données de démonstration ---
# true = seed automatique (~9 équipes, comptes de démo) au premier démarrage.
# Mettre à false pour démarrer avec une base vide.
SEED_DEMO=true

# ============================================================================
# Authentification
# ============================================================================

# --- 1) Compte de secours (breaking-glass) - toujours actif ---
# Si BREAKGLASS_PASSWORD est vide, un mot de passe aléatoire est généré et
# imprimé dans les logs du conteneur `app` au premier démarrage.
BREAKGLASS_EMAIL=admin@local
BREAKGLASS_PASSWORD=changeme-admin

# Les URL que votre fournisseur d'identité doit connaître sont TOUJOURS
# construites à partir de PUBLIC_BASE_URL, vous n'avez donc rien à recopier ici :
#   redirection OIDC : <PUBLIC_BASE_URL>/api/auth/oidc/callback
#   entity ID SAML   : <PUBLIC_BASE_URL>/api/auth/saml/metadata
#   ACS SAML         : <PUBLIC_BASE_URL>/api/auth/saml/acs
# Administration > Authentification les affiche prêtes à copier chez l'IdP.

# --- 2) OIDC (Authorization Code + PKCE) - optionnel ---
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
# Ne renseignez OIDC_REDIRECT_URI que pour forcer une URL différente de celle
# dérivée de PUBLIC_BASE_URL (enregistrement IdP existant, non modifiable).
OIDC_REDIRECT_URI=

# --- 3) SAML 2.0 (cible PingFederate) - optionnel ---
SAML_ENABLED=false
# Fournir SOIT une URL de métadonnées IdP, SOIT un chemin vers un fichier XML.
SAML_IDP_METADATA_URL=
SAML_IDP_METADATA_PATH=
# Idem : vides = dérivés de PUBLIC_BASE_URL. À ne remplir que pour forcer.
SAML_SP_ENTITY_ID=
SAML_ACS_URL=
# Certificat / clé du Service Provider (PEM sur une ligne, sans en-têtes), si signature requise.
SAML_SP_CERT=
SAML_SP_KEY=
