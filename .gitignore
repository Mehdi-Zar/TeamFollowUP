.DS_Store

# Local editor / assistant tooling config (never versioned)
.claude/

# Build output served by the backend (regenerated by the Docker build)
backend/app/static/

# Local Postgres dumps / backups
backups/

# Office temp lock files and large source decks (kept locally, not versioned)
~$*
*.pptx

# Real org import data (keep private; only org.example.yaml is tracked)
backend/data/org.yaml
backend/data/org.xlsx
.sim-gke/
# Local end-to-end benches (minikube + Keycloak). They generate a throwaway PKI,
# private keys included, which must never reach the repository. The tutorial
# regenerates everything from scratch.
.k8s-test/

# Throwaway PKI generated by the Kubernetes bench (private keys, never versioned)
bench/k8s-sso/pki/

# Coverage data (regenerated by every measured run)
.coverage
.coverage.*
htmlcov/
